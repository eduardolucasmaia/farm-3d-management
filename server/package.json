{
  "name": "farm3d-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/api/main.ts",
    "start": "node --env-file-if-exists=../.env src/api/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../.env src/infrastructure/db/migrate-cli.ts",
    "job:hourly": "node --env-file-if-exists=../.env src/infrastructure/jobs/run-once.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
