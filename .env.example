# Copie para .env e preencha os valores vazios. Nunca versione o .env.
NODE_ENV=development
PORT=5088
FARM3D_DB_PATH=data/farm3d.db
FARM3D_FILES_DIR=data/files3d
CORS_ORIGINS=http://localhost:5173
# Segredo: 32 caracteres ou mais.
JWT_SIGNING_KEY=
# Só em development. Política: 6+ caracteres, maiúscula, minúscula, dígito e símbolo.
FARM3D_SEED_PASSWORD=
